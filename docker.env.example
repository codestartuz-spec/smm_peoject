# Server (Docker) uchun .env namunasi. deploy.sh uni avtomatik to'ldiradi; qo'lda: cp docker.env.example .env
SECRET_KEY=CHANGE_ME
DEBUG=0
ALLOWED_HOSTS=smm.elshod.date,127.0.0.1,localhost
BEHIND_PROXY=1
PUBLIC_BASE_URL=https://smm.elshod.date

# MySQL (docker-compose ichidagi 'db' xizmati). DB_PASSWORD bazaning root paroli ham bo'ladi.
DB_NAME=smm_db
DB_USER=root
DB_PASSWORD=CHANGE_ME
DB_HOST=db
DB_PORT=3306

# Cloudflare Tunnel tokeni (Zero Trust -> Networks -> Tunnels)
TUNNEL_TOKEN=

# Birinchi ishga tushirishda admin yaratiladi (keyin Profil sahifasidan o'zgartirasiz)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=CHANGE_ME
DJANGO_SUPERUSER_EMAIL=

# AI, Telegram, Cloudflare R2, Google, Meta kalitlari — veb sahifadagi Sozlamalar bo'limidan kiritiladi.
AI_PROVIDERS=gemini,groq,openrouter

# ---- Django ----
SECRET_KEY=bu-yerga-uzun-tasodifiy-qator-yozing
DEBUG=1
ALLOWED_HOSTS=127.0.0.1,localhost
# Instagram media URL ochiq bo'lishi shart: cloudflared/ngrok bepul tunnel manzili (masalan https://xxxx.trycloudflare.com)
PUBLIC_BASE_URL=http://127.0.0.1:8000

# ---- MySQL ----
DB_ENGINE=mysql
DB_NAME=smm_db
DB_USER=root
DB_PASSWORD=12345
DB_HOST=127.0.0.1
DB_PORT=3306

# ---- AI provayderlar (hech bo'lmasa bittasini to'ldiring) ----
# Tartib: birinchisi ishlamasa keyingisi sinaladi. Pullik (anthropic, openai) ni faqat xohlasangiz qo'shing.
AI_PROVIDERS=gemini,groq,openrouter
# https://aistudio.google.com/apikey  (bepul)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# https://console.groq.com/keys  (bepul)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# https://openrouter.ai/keys  (":free" modellar bepul)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# https://console.anthropic.com/settings/keys  (PULLIK, kredit kerak)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# https://platform.openai.com/api-keys  (PULLIK, kredit kerak)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Telegram hisobot boti (sizga xabar yuboradi) ----
NOTIFY_BOT_TOKEN=
NOTIFY_CHAT_ID=

# ---- Google (YouTube) OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Meta (Instagram/Facebook) ----
META_APP_ID=
META_APP_SECRET=
